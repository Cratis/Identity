<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- AssemblyName must match PackageId: type discovery resolves a referenced project by the library name in deps.json. -->
    <AssemblyName>Cratis.Identity.Contracts</AssemblyName>
    <RootNamespace>Cratis.Identity.Contracts</RootNamespace>
    <PackageId>Cratis.Identity.Contracts</PackageId>
    <Description>The contracts of Cratis Identity: the claim types its access tokens carry.</Description>
    <PackageTags>cratis;identity;oauth;contracts</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cratis.Chronicle" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
