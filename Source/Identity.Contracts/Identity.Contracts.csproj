<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- AssemblyName must match PackageId: type discovery resolves a referenced project by the library name in deps.json. -->
    <AssemblyName>Cratis.Identity.Contracts</AssemblyName>
    <RootNamespace>Cratis.Identity.Contracts</RootNamespace>
    <PackageId>Cratis.Identity.Contracts</PackageId>
    <Description>The contracts of Cratis Identity: the claim types its access tokens carry.</Description>
    <PackageTags>cratis;identity;oauth;contracts</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contracts only use the event-type attributes, and every consumer already references the Chronicle client, so the
         package does not declare it as a dependency: a consumer pinned below the version Cratis Identity runs on can still
         reference this package, where a declared dependency would force it up (NU1605). -->
    <PackageReference Include="Cratis.Chronicle" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
