{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "OpenIddict": "Warning"
    }
  },
  "Chronicle": {
    "ConnectionString": "chronicle://localhost:35000?skipTlsValidation=true"
  },
  "Identity": {
    "Issuer": "http://localhost:5100/",
    "Accounts": {
      "ConfirmNoLegacyMongoStore": true
    },
    "Development": {
      "Clients": [
        {
          "ClientId": "local-claude",
          "DisplayName": "Claude (local)",
          "RedirectUris": ["http://localhost/callback", "http://127.0.0.1/callback", "http://[::1]/callback"]
        },
        {
          "ClientId": "local-pi",
          "DisplayName": "pi (local, provisional)",
          "RedirectUris": ["http://localhost/callback", "http://127.0.0.1/callback", "http://[::1]/callback"]
        },
        {
          "ClientId": "local-vscode",
          "DisplayName": "VS Code (local)",
          "RedirectUris": ["http://127.0.0.1:33418", "http://127.0.0.1/callback", "http://localhost/callback"]
        }
      ],
      "Resources": [
        {
          "Audience": "direct-mcp",
          "ReceivesUpstreamIdentity": true,
          "DisplayName": "Cratis Direct MCP (local)",
          "Indicators": ["http://localhost:5200/mcp"],
          "Scopes": [
            { "Name": "direct:mcp:read", "Description": "Read your content, voices, context and work status through MCP." },
            { "Name": "direct:mcp:content.write", "Description": "Create and revise drafts through MCP. Publishing still needs your approval in Direct." },
            { "Name": "direct:mcp:work", "Description": "Start and follow work through MCP." }
          ],
          "Tenants": [{ "Id": "local", "Name": "Local development", "AllowAllAccounts": true }]
        },
        {
          "Audience": "studio-mcp",
          "ReceivesUpstreamIdentity": true,
          "DisplayName": "Cratis Studio MCP (local)",
          "Indicators": ["http://localhost:5300/mcp"],
          "Scopes": [
            { "Name": "studio:mcp:read", "Description": "Read your organization's structure, event models and concepts through MCP." },
            { "Name": "studio:mcp:write", "Description": "Propose and apply edits to your organization's event models through MCP." }
          ],
          "Tenants": [{ "Id": "local", "Name": "Local development", "AllowAllAccounts": true }]
        }
      ]
    }
  }
}
