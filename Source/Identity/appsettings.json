{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Issuer": "",
    "MongoDB": {
      "ConnectionString": "mongodb://localhost:27017",
      "Database": "cratis-identity"
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Tokens": {
      "AccessTokenLifetime": "00:15:00",
      "AuthorizationCodeLifetime": "00:02:00",
      "RefreshTokenLifetime": "30.00:00:00"
    },
    "SessionLifetime": "01:00:00",
    "Resources": [
      {
        "Audience": "direct-api",
        "DisplayName": "Cratis Direct",
        "Indicators": [
          "https://cratis.direct/mcp",
          "https://cratis.direct/v1"
        ],
        "Scopes": [
          { "Name": "direct:read", "Description": "Read your content, voices, context and work status." },
          { "Name": "direct:content.write", "Description": "Create and revise drafts. Publishing still needs your approval in Direct." },
          { "Name": "direct:work", "Description": "Start and follow work such as drafting and rendering." }
        ],
        "Tenants": []
      }
    ],
    "IntrospectionClients": []
  }
}
