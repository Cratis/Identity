<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Required by source-generated macOS ACL interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Cratis.Identity</RootNamespace>
    <AssemblyName>Cratis.Identity</AssemblyName>
    <PackageId>Cratis.Identity</PackageId>
    <Description>Cratis Identity: an OAuth 2.1 authorization server module (OpenIddict) that a host adds with AddCratisIdentity() and MapCratisIdentity().</Description>
    <PackageTags>cratis;identity;oauth;openiddict;authorization-server</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The Arc proxy generator resolves referenced assemblies from the library output. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- The TypeScript proxies for Identity's commands and queries are generated into the @cratis/identity npm package.
         Release builds of the host image clear CratisProxiesOutputPath (-p:CratisProxiesOutputPath=). -->
    <CratisProxiesOutputPath>$(MSBuildThisFileDirectory)../JavaScript/Identity</CratisProxiesOutputPath>
    <CratisProxiesSegmentsToSkip>2</CratisProxiesSegmentsToSkip>
    <CratisProxiesSkipOutputDeletion>true</CratisProxiesSkipOutputDeletion>
    <CratisProxiesUseSourceFileAsOutputFile>true</CratisProxiesUseSourceFileAsOutputFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cratis.Arc" />
    <PackageReference Include="Cratis.Arc.Chronicle" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.MongoDb" />
    <PackageReference Include="Cratis.Arc.ProxyGenerator.Build">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Identity.Contracts/Identity.Contracts.csproj" />
    <ProjectReference Include="../Identity.FenceLog.Mongo/Identity.FenceLog.Mongo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cratis.Identity.Specs" />
    <InternalsVisibleTo Include="Cratis.Identity.Integration.Specs" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
