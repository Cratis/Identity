{
    "name": "client-credentials-unbound-refused",
    "description": "Confidential organisation automation cannot receive unbound client-credentials tokens despite successful private_key_jwt authentication and an incorrectly unset registration flag.",
    "given": {
        "registered_client": {
            "client_id": "organisation-automation-test",
            "client_type": "confidential",
            "principal_kind": "organisation_automation",
            "token_endpoint_auth_method": "private_key_jwt",
            "dpop_bound_access_tokens": false
        },
        "client_authentication": { "method": "private_key_jwt", "result": "valid" },
        "confirmed_organisation_policy": { "requires_dpop": false },
        "grant_and_other_checks": "authorized",
        "token_request": {
            "grant_type": "client_credentials",
            "resource": "https://direct.cratis.io",
            "dpop_header": null
        }
    },
    "when": { "action": "issue_tokens_at_identity" },
    "then": {
        "outcome": "refused",
        "http_status": 400,
        "error": "invalid_dpop_proof",
        "access_token_issued": false,
        "refresh_token_issued": false,
        "bearer_fallback": false
    }
}
