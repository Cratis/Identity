{
    "name": "wrong-htm",
    "description": "A GET proof does not authorize the external POST request.",
    "given": {
        "authorization_scheme": "DPoP",
        "proof": { "header": {}, "payload": { "htm": "GET" }, "signature": "valid" }
    },
    "when": { "action": "validate_at_authproxy_and_forward_v2" },
    "then": {
        "outcome": "reject",
        "reason": "invalid_htm",
        "http_status": 401,
        "challenge_scheme": "DPoP",
        "error": "invalid_dpop_proof",
        "algs": "ES256",
        "forwarded": false
    }
}
