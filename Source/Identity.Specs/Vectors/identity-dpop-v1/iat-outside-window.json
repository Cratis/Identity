{
    "name": "iat-outside-window",
    "description": "A proof exactly 300 seconds old is outside the strict past-age window.",
    "given": {
        "authorization_scheme": "DPoP",
        "proof": { "header": {}, "payload": { "iat": 1999999700 }, "signature": "valid" }
    },
    "when": { "action": "validate_at_authproxy_and_forward_v2" },
    "then": {
        "outcome": "reject",
        "reason": "invalid_iat",
        "http_status": 401,
        "challenge_scheme": "DPoP",
        "error": "invalid_dpop_proof",
        "algs": "ES256",
        "forwarded": false
    }
}
