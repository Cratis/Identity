{
    "name": "jwk-thumbprint-mismatch",
    "description": "A valid proof key that differs from the issuer's cnf.jkt cannot present the token.",
    "given": {
        "authorization_scheme": "DPoP",
        "access_token": { "cnf": { "jkt": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" } },
        "proof": { "header": {}, "payload": {}, "signature": "valid" }
    },
    "when": { "action": "validate_at_authproxy_and_forward_v2" },
    "then": {
        "outcome": "reject",
        "reason": "jkt_mismatch",
        "http_status": 401,
        "challenge_scheme": "DPoP",
        "error": "invalid_dpop_proof",
        "algs": "ES256",
        "forwarded": false
    }
}
