{
    "name": "nonce-encoding",
    "description": "Real encodings of the §5.1 HMAC server nonce, checked by the AuthProxy resource validator in the §5.1 order. Every failure is a use_dpop_nonce challenge with a fresh nonce; the request is never forwarded.",
    "given": {
        "validator": "authproxy",
        "validator_domain": 2,
        "now": 2000000000,
        "origin": "https://direct.cratis.io",
        "verify_set": ["nk-test1"],
        "synthetic_key": "Test-only HMAC key: the byte 0x2a repeated 32 times, for kid nk-test1 (ASCII, 8 bytes). Not a real key.",
        "random": "Bytes 0x00 to 0x0f in order (synthetic, not CSPRNG output).",
        "proof_jkt": "xx0BcA-wMohw8atYDJOe6peGModklG2wRHBlXHMvl0M"
    },
    "when": { "action": "validate_nonce_cases" },
    "then": {
        "cases": [
            {
                "name": "valid",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZP2AAECAwQFBgcICQoLDA0OD8GOOuaZxLMv2qsmiVs66goVT_MQX8e1NP5vxRjFjKGZ",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-test1", "issued_at": 1999999990 },
                "outcome": "accept"
            },
            {
                "name": "wrong-domain",
                "description": "An authorization-server nonce (domain 0x01) presented to the resource validator.",
                "nonce": "AQFuay10ZXN0MQAAAAB3NZP2AAECAwQFBgcICQoLDA0OD1pN8Igp4Mp2cBK5UACxmvh8yxCs2MKMhu7uVqqgrXRb",
                "decoded": { "ver": 1, "domain": 1, "kid": "nk-test1", "issued_at": 1999999990 },
                "outcome": "reject",
                "reason": "nonce_wrong_domain"
            },
            {
                "name": "wrong-origin",
                "description": "Minted for https://studio.cratis.io; the MAC does not verify for this origin.",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZP2AAECAwQFBgcICQoLDA0OD9UrJ_3WNp7XwJeEfJnHeMl6cm8J9tuxlzNF7jtEkTdb",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-test1", "issued_at": 1999999990 },
                "outcome": "reject",
                "reason": "nonce_invalid_mac"
            },
            {
                "name": "wrong-jkt",
                "description": "The valid nonce, presented in a proof whose key thumbprint differs from the one it was issued for.",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZP2AAECAwQFBgcICQoLDA0OD8GOOuaZxLMv2qsmiVs66goVT_MQX8e1NP5vxRjFjKGZ",
                "proof_jkt": "y_hww8NZc6B-6dn23NpfIjOz8EM3db4LRCIyomHUKa0",
                "outcome": "reject",
                "reason": "nonce_invalid_mac"
            },
            {
                "name": "unknown-kid",
                "nonce": "AQJuay1vdGhlcgAAAAB3NZP2AAECAwQFBgcICQoLDA0OD0acPRlPqEhShGjgr_4_T8LrNJRsbuGwJuVRbNR3fk6-",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-other", "issued_at": 1999999990 },
                "outcome": "reject",
                "reason": "nonce_unknown_kid"
            },
            {
                "name": "last-valid-second",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZK3AAECAwQFBgcICQoLDA0OD6fltS7M9dcbxCwaj7-SUuzlniep0IdByTB9QmHZcy0P",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-test1", "issued_at": 1999999671 },
                "outcome": "accept"
            },
            {
                "name": "expired",
                "description": "now < issued_at + 330 fails at the boundary.",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZK2AAECAwQFBgcICQoLDA0OD7G_77Tg43qQA3SNwsj6QNpfGVablQryu8Y7BXZ3LpW-",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-test1", "issued_at": 1999999670 },
                "outcome": "reject",
                "reason": "nonce_expired"
            },
            {
                "name": "future-at-skew-limit",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZQeAAECAwQFBgcICQoLDA0ODywmxWOjEOJqcVoYZambaJXZNVDfKRiw3BIasJDKnUz2",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-test1", "issued_at": 2000000030 },
                "outcome": "accept"
            },
            {
                "name": "future",
                "description": "issued_at <= now + 30 fails one second past the skew limit.",
                "nonce": "AQJuay10ZXN0MQAAAAB3NZQfAAECAwQFBgcICQoLDA0OD4e9kW7mq_iEApbzTn1gmqJQBE82jM7ppMs-8KpiUQ_0",
                "decoded": { "ver": 1, "domain": 2, "kid": "nk-test1", "issued_at": 2000000031 },
                "outcome": "reject",
                "reason": "nonce_from_future"
            }
        ],
        "on_reject": {
            "http_status": 401,
            "challenge_scheme": "DPoP",
            "error": "use_dpop_nonce",
            "algs": "ES256",
            "fresh_nonce": true,
            "forwarded": false
        }
    }
}
