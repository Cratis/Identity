          "properties": [{ "name": "AuthorizationCodeHash", "type": "SecretDigest" }]
        },
        "registry": {
          "SecretDigest": {
            "underlyingType": "System.String",
            "kind": "secret-hash",
            "algorithm": "HMAC-SHA-256",
            "keyed": true,
            "inputEntropy": "low",
            "purpose": "approved-code-audit",
            "hashKeyRevision": "hash-key-1",
            "producerSpec": "keyed-code-digest-before-append",
            "justification": "One-way keyed audit digest, never redeemable; does not permit code-redemption events."
          }
        }
      },
      "when": { "action": "check_event_contract" },
      "then": { "outcome": "pass", "violations": [] }
    },
