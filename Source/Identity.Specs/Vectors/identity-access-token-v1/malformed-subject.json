{
    "name": "malformed_subject",
    "description": "An uppercase UUID-v4 subject is malformed under contract v1 and MUST NOT be normalized into acceptance.",
    "given": {
        "token": {
            "serialization": "JWS",
            "parts": 3,
            "header": { "typ": "at+jwt", "alg": "ES256", "kid": "key-1" },
            "payload": {
                "iss": "https://identity.example.test",
                "sub": "8B167AD2-0F89-4C78-9D42-6D4580495D32",
                "aud": "direct-api",
                "iat": 1999999900,
                "exp": 2000000200,
                "client_id": "cli-test",
                "jti": "98a61c34-c366-46af-8759-e4bb3e84869a",
                "scope": "direct:read",
                "tid": "t-1234",
                "idp": "https://upstream.example.test",
                "idp_sub": "upstream-person-1",
                "auth_time": 1999999800,
                "acr": "basic"
            },
            "signature": "valid"
        }
    },
    "when": { "action": "validate_access_token" },
    "then": { "outcome": "reject", "reason": "invalid_subject", "status": 401, "error": "invalid_token" }
}
