{
    "name": "application_at_jwt",
    "description": "The application/at+jwt type alias is accepted, though issuers emit at+jwt.",
    "given": {
        "token": {
            "serialization": "JWS",
            "parts": 3,
            "header": { "typ": "application/at+jwt", "alg": "ES256", "kid": "key-1" },
            "payload": {
                "iss": "https://identity.example.test",
                "sub": "8b167ad2-0f89-4c78-9d42-6d4580495d32",
                "aud": "direct-api",
                "iat": 1999999900,
                "exp": 2000000200,
                "client_id": "cli-test",
                "jti": "98a61c34-c366-46af-8759-e4bb3e84869a",
                "scope": "direct:read",
                "tid": "t-1234",
                "idp": "https://upstream.example.test",
                "idp_sub": "upstream-person-1",
                "auth_time": 1999999800,
                "acr": "basic"
            },
            "signature": "valid"
        }
    },
    "when": { "action": "validate_access_token" },
    "then": { "outcome": "accept", "audience": "direct-api" }
}
