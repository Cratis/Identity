{
    "name": "cross-tenant-credential-refused-before-namespace",
    "description": "A PAT fixed to t-alpha is refused by the application when the requested target is t-beta, before membership lookup or namespace selection.",
    "given": {
        "credential": {
            "credential_kind": "pat",
            "resource": "https://direct.example.test/mcp",
            "installation": "direct-installation-a",
            "environment": "production",
            "tenant": "t-alpha",
            "scopes": ["direct:read"]
        },
        "dispatched_by_authproxy": true,
        "person_memberships": ["t-alpha"],
        "namespace_mapping": { "t-alpha": "ns-alpha", "t-beta": "ns-beta" }
    },
    "when": {
        "action": "resolve_workspace_request",
        "requested_target": {
            "source": "route",
            "resource": "https://direct.example.test/mcp",
            "installation": "direct-installation-a",
            "environment": "production",
            "tenant": "t-beta"
        }
    },
    "then": {
        "outcome": "refused",
        "reason": "tenant_constraint_mismatch",
        "checked_by": "application",
        "namespace_selected": null,
        "membership_checked": false,
        "downstream_called": false,
        "operation_executed": false,
        "credential_constraints_unchanged": true
    }
}
