    {"given": {"credentialCount": 2}, "when": {"operation": "dispatch"}, "then": {"accepted": false, "verifierSelected": false}},
    {"given": {"credentialInUriQuery": true}, "when": {"operation": "dispatch"}, "then": {"accepted": false, "verifierSelected": false}}
