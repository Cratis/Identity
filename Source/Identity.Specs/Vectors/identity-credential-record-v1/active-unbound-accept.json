{
    "name": "active-unbound-accept",
    "description": "An active, unbound OAuth grant presented as Bearer is accepted with the credential id from introspection and an explicit unbound result.",
    "given": {
        "authorization_scheme": "Bearer",
        "introspection_response": {
            "active": true,
            "credential_kind": "oauth-grant",
            "credential_id": "6f1c2b4e-9d3a-4c58-8a71-2e5b0d7a91c3",
            "aud": "studio-mcp",
            "tid": "tenant-fixture",
            "scope": "studio:read",
            "cache_epoch": 7
        }
    },
    "when": { "action": "build_oauth_envelope_at_authproxy" },
    "then": {
        "outcome": "accept",
        "credential_kind": "oauth-grant",
        "credential_id": "6f1c2b4e-9d3a-4c58-8a71-2e5b0d7a91c3",
        "sender_binding": { "result": "unbound", "wire": "none" }
    }
}
