  "when": [
    { "order": 1, "t": 0, "action": "revoke", "target": "family-1", "request_id": "revoke-1" },
    { "order": 2, "t": 0, "action": "commit_fence_and_outbox", "fence_id": "fence-41", "fence_sequence": 41, "outbox_id": "fact-41" },
    { "order": 3, "t": 0, "action": "durably_append_fence_log", "fence_id": "fence-41", "log_watermark": 41 },
    { "order": 4, "t": 0, "action": "crash_before_acknowledgement" },
    { "order": 5, "t": 1, "action": "restart_and_reconcile_to_log_barrier", "barrier": 41 },
    { "order": 6, "t": 2, "action": "retry_revoke", "target": "family-1", "request_id": "revoke-1" },
    { "order": 7, "t": 3, "action": "revoke_again_with_different_request_id", "target": "family-1", "request_id": "revoke-2" }
