{
    "name": "restore-operational-store-consumed-refresh",
    "description": "Any restore advances the recovery epoch; neither the consumed refresh token nor its replacement can resurrect after fence replay.",
    "given": {
        "target": "family-1",
        "recovery_epoch": 7,
        "family_version": 7,
        "refresh_token": "refresh-old",
        "refresh_token_state": "unconsumed",
        "operational_snapshot_watermark": 40,
        "log_watermark": 40,
        "chronicle_watermark": 40,
        "chronicle_available": false,
        "monotonic_epoch_authority": "healthy_outside_both_restorable_stores"
    },
    "when": [
        { "order": 1, "t": 0, "action": "snapshot_operational_store", "watermark": 40, "refresh_token_state": "unconsumed" },
        { "order": 2, "t": 1, "action": "commit_consume_and_replace_cas", "consumed": "refresh-old", "replacement": "refresh-new", "family_version": 8, "recovery_epoch": 7 },
        { "order": 3, "t": 1, "action": "release_replacement", "refresh_token": "refresh-new", "log_watermark": 40 },
        { "order": 4, "t": 2, "action": "restore_operational_snapshot", "watermark": 40, "expected_ready": false },
        { "order": 5, "t": 3, "action": "present_old_refresh_before_recovery", "expected": "deny" },
        { "order": 6, "t": 4, "action": "durably_advance_recovery_epoch_outside_both_stores", "recovery_epoch": 8, "fence_sequence": 41, "log_watermark": 41, "outbox_id": "recovery-fact-41", "expected_ready": false },
        { "order": 7, "t": 4, "action": "persist_operational_watermark_and_publication_intent", "watermark": 41, "outbox_id": "recovery-fact-41", "event_type": "RealmRecoveryEpochAdvanced" },
        { "order": 8, "t": 5, "action": "prove_independent_restriction_coverage_and_retirement_tombstones", "barrier": 41 },
        { "order": 9, "t": 6, "action": "enforce_epoch_on_all_replicas_and_persist_recovery_readiness", "recovery_epoch": 8 },
        { "order": 10, "t": 7, "action": "present_old_refresh_after_recovery_on_another_replica", "expected": "deny" },
        { "order": 11, "t": 8, "action": "present_replacement_after_recovery", "expected": "deny" }
    ],
    "then": {
        "ready": true,
        "recovery_epoch": 8,
        "family_state": "epoch_invalidated",
        "old_refresh_redemption": "deny",
        "replacement_refresh_redemption": "deny",
        "new_tokens_after_restore": 0,
        "reauthentication_required": true,
        "fence_coverage_alone_reopens_refresh": false,
        "epoch_durable_outside_both_restorable_stores": true,
        "all_affected_verifiers_enforce_epoch_before_readiness": true,
        "log_watermark": 41,
        "operational_watermark": 41,
        "chronicle_watermark": 40,
        "pending_outbox_fact_count": 1,
        "pending_outbox_facts": [{ "outbox_id": "recovery-fact-41", "event_type": "RealmRecoveryEpochAdvanced", "recovery_epoch": 8 }]
    }
}
