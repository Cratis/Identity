<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Cratis.Identity.Server</RootNamespace>
    <AssemblyName>Cratis.Id.Host</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Publish server configuration without leaking it into referencing checker/spec outputs. -->
    <Content Update="appsettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cratis.Chronicle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Identity/Identity.csproj" />
    <InternalsVisibleTo Include="Cratis.Identity.Specs" />
  </ItemGroup>

</Project>
