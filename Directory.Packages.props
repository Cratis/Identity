<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive; 10.0.11 carries known advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-c399-9853-6jmj, GHSA-7hqp-7c5m-4vq6, GHSA-r955-8q5j-3h83). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />
    <!-- OpenIddict -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.8.0" />
    <PackageVersion Include="OpenIddict.MongoDb" Version="7.8.0" />
    <!-- Cratis Chronicle -->
    <PackageVersion Include="Cratis.Chronicle" Version="19.160.0" />
    <PackageVersion Include="Cratis.Chronicle.AspNetCore" Version="19.160.0" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.160.0" />
    <PackageVersion Include="Cratis.Arc.Chronicle" Version="22.185.0" />
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="22.185.0" />
    <!-- Cratis Arc -->
    <PackageVersion Include="Cratis.Arc" Version="22.185.0" />
    <PackageVersion Include="Cratis.Arc.ProxyGenerator.Build" Version="22.185.0" />
    <!-- MongoDB -->
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <!-- System -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />
    <!-- Specifications -->
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.0.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.15.0" />
  </ItemGroup>
</Project>
